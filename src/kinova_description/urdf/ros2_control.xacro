<?xml version="1.0"?>
<robot name="GEN3-7DOF-NOVISION_FOR_URDF_ARM_V12" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="kinova_description" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
   
    
<joint name="joint_1">
  <command_interface name="position" />
  <state_interface name="position">
    <param name="initial_value">1.57</param>
  </state_interface>
  <state_interface name="velocity" />
</joint>

<joint name="joint_2">
  <command_interface name="position">
    <param name="min">-2.24</param>
    <param name="max">2.24</param>
  </command_interface>
  <state_interface name="position">
    <param name="initial_value">-0.35</param>
  </state_interface>
  <state_interface name="velocity" />
</joint>

<joint name="joint_3">
  <command_interface name="position" />
  <state_interface name="position">
    <param name="initial_value">3.14</param>
  </state_interface>
  <state_interface name="velocity" />
</joint>

<joint name="joint_4">
  <command_interface name="position">
    <param name="min">-2.57</param>
    <param name="max">2.57</param>
  </command_interface>
  <state_interface name="position">
    <param name="initial_value">-2.00</param>
  </state_interface>
  <state_interface name="velocity" />
</joint>

<joint name="joint_5">
  <command_interface name="position" />
  <state_interface name="position">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="velocity" />
</joint>

<joint name="joint_6">
  <command_interface name="position">
    <param name="min">-2.09</param>
    <param name="max">2.09</param>
  </command_interface>
  <state_interface name="position">
    <param name="initial_value">-1.00</param>
  </state_interface>
  <state_interface name="velocity" />
</joint>

<joint name="joint_7">
  <command_interface name="position" />
  <state_interface name="position">
    <param name="initial_value">1.57</param>
  </state_interface>
  <state_interface name="velocity" />
</joint>

  </ros2_control>

</robot>